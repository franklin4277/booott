# Copy this file to .env.local (gitignored) and replace placeholders before starting.
# Values here are development examples, not production secrets.

# Local mode uses SQLite by default. Services require a shared Redis-compatible
# server such as Redis or Memurai; fakeredis is only suitable for single-process tests.
# Set DATABASE_URL explicitly to use PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./trading_local.db
REDIS_URL=redis://localhost:6379/0
REDIS_USE_FAKEREDIS=false

# HMAC signing key for SignedOrderPayload (32+ bytes). SECRET_KEY is an alias.
ORDER_SIGNING_SECRET=replace-with-at-least-32-random-bytes
SECRET_KEY=replace-with-at-least-32-random-bytes

# API Gateway
API_PORT=8000
API_GATEWAY_KEY=replace-with-a-separate-random-32-byte-secret

# Market data
MARKET_DATA_INGEST_PORT=8020
MARKET_DATA_INGEST_URL=http://127.0.0.1:8020
MT5_MARKET_DATA_ENABLED=true
MT5_MARKET_SYMBOLS=EURUSD
MT5_MARKET_TIMEFRAMES=M5,M15,H1
MT5_MARKET_HISTORY_BARS=128
MT5_MARKET_MAX_TICK_AGE_SECONDS=30
MT5_MARKET_POLL_SECONDS=1

# Market data indicator and pattern engine
INDICATOR_EMA_PERIOD=20
INDICATOR_ATR_PERIOD=14
INDICATOR_RSI_PERIOD=14
INDICATOR_SPREAD_PERIOD=20
PATTERN_BASE_TIMEFRAME=M5
PATTERN_CONFIRMATION_TIMEFRAMES=M15,H1
PATTERN_HISTORY_SIZE=128
PATTERN_STRUCTURE_LOOKBACK=20
PATTERN_ATR_PERIOD=14
PATTERN_ATR_BASELINE_PERIOD=50
PATTERN_ATR_EXPANSION_RATIO=1.2
PATTERN_MAX_SPREAD_RATIO=2.5
PATTERN_STOP_ATR_MULTIPLIER=1.5
PATTERN_REWARD_RISK_RATIO=2.0
PATTERN_SIGNAL_VALIDITY_MINUTES=30

# AI provider. Keep real keys only in the untracked .env file / secret store.
AI_PROVIDER=openai
AI_API_KEY=replace-with-provider-api-key
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=20
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RECOVERY_SECONDS=300
AI_STATE_PUBLISH_INTERVAL_SECONDS=10
AI_RATE_LIMIT_CAPACITY=5
AI_RATE_LIMIT_REFILL_PER_SECOND=1
AI_QUANT_OVERRIDE_ENABLED=false

# Risk limits (currency amounts and fractions should be calibrated per account)
RISK_MAX_POSITION_SIZE=0.01
RISK_MAX_DAILY_LOSS=100.0
RISK_MAX_DRAWDOWN_PCT=5.0
RISK_MAX_OPEN_TRADES=3
RISK_MAX_SPREAD_POINTS=30
RISK_MAX_PORTFOLIO_HEAT_PCT=2.0
RISK_MAX_CORRELATED_EXPOSURE_PCT=1.0
RISK_CORRELATION_THRESHOLD=0.7
RISK_CORRELATION_MATRIX={"XAUUSD|EURUSD":0.75}
RISK_CONTRACT_UNITS=100000
RISK_MIN_AI_CONFIDENCE=0.65
RISK_ORDER_TTL_SECONDS=5
RISK_MAX_SIGNAL_AGE_SECONDS=60
RISK_ACCOUNT_STATE_MAX_AGE_SECONDS=15
RISK_NEWS_EMBARGO_MINUTES=15

# MT5 native economic-calendar bridge (attach mt5/Experts/EconomicCalendarBridge.mq5).
# Empty path uses %APPDATA%\MetaQuotes\Terminal\Common\Files\booott_economic_calendar.tsv.
MT5_CALENDAR_FILE=
MT5_CALENDAR_MAX_AGE_SECONDS=180

# Windows MT5 host bridge and reconciliation
# Use separate random secrets, each at least 32 bytes.
MT5_ADAPTER_URL=http://localhost:8765
MT5_ADAPTER_TOKEN=replace-with-a-separate-random-32-byte-secret
MT5_ADAPTER_TIMEOUT_SECONDS=10
MT5_ADAPTER_PORT=8765
MT5_LIVE_TRADING_ENABLED=false
MT5_ORDER_LEDGER_PATH=
MT5_MAX_DEVIATION_POINTS=20
MT5_EXPERT_MAGIC=427700
MT5_EA_BRIDGE_HOST=127.0.0.1
MT5_EA_BRIDGE_PORT=5557
MT5_TERMINAL_PATH=
MT5_WATCHDOG_HEARTBEAT_TIMEOUT_SECONDS=15
MT5_WATCHDOG_STARTUP_GRACE_SECONDS=120
MT5_WATCHDOG_RESTART_GRACE_SECONDS=20
HOST_WATCHDOG_POLL_SECONDS=10
RECONCILIATION_INTERVAL_SECONDS=15
RECONCILIATION_PORT=8010
RECONCILIATION_API_TOKEN=replace-with-another-random-32-byte-secret
RECONCILIATION_URL=http://localhost:8010
PAGERDUTY_ROUTING_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram numeric user IDs authorized to issue private-chat commands.
TELEGRAM_ALLOWED_USER_IDS=
# Optional notification destinations; comma-separated chat IDs, defaults to TELEGRAM_CHAT_ID.
TELEGRAM_NOTIFICATION_CHAT_IDS=
TELEGRAM_DRAWDOWN_WARNING_PCT=3.0
TELEGRAM_STATUS_INTERVAL_SECONDS=15
TRADE_MAX_AGE_HOURS=24
TRADE_ADVERSE_MOVE_PCT=5.0
TRADE_MONITOR_POLL_SECONDS=15

# Feature flags
FEATURE_AI_SIGNALS=false
FEATURE_PAPER_TRADING=true
FEATURE_KILL_SWITCH=false

# Service ports
RISK_ENGINE_PORT=8001
PATTERN_ENGINE_PORT=8002
AI_ENGINE_PORT=8003
EXECUTION_ENGINE_PORT=8004
TELEGRAM_BOT_PORT=8005
MARKET_ENGINE_PORT=8006
TRADE_MONITOR_PORT=8007
LOG_LEVEL=info
